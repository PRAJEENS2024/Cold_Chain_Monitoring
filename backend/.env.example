# Backend Environment Configuration Example
# Do not place real secrets in this file. Copy to .env for local development.

# Database Configuration (Use SQLite for local, PostgreSQL for cloud)
# DATABASE_URL=postgresql://user:pass@host/db
DATABASE_URL=sqlite:///./coldchain.db

# Authentication (Must be a strong random 32-character string in production)
JWT_SECRET_KEY=replace_this_with_a_highly_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.onrender.com

# System Configuration
# Time in seconds before a device is considered offline
DEVICE_ONLINE_TIMEOUT_SECONDS=60
